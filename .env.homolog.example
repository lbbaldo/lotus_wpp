# Runtime
NODE_ENV=production
PORT=8080
LOG_LEVEL=info

# Bot database (microservice own database)
DATABASE_URL=postgres://bot_user:CHANGE_ME@postgres:5432/whatsapp_bot
REDIS_URL=redis://redis:6379

# Lotus -> Bot webhook security
LOTUS_WEBHOOK_API_KEY=CHANGE_ME_WITH_LONG_RANDOM_64
LOTUS_WEBHOOK_HMAC_SECRET=CHANGE_ME_WITH_LONG_RANDOM_64
LOTUS_WEBHOOK_MAX_SKEW_SECONDS=300

# Evolution API v2
EVOLUTION_BASE_URL=https://evolution.seu-dominio.com
EVOLUTION_API_KEY=CHANGE_ME_EVOLUTION_API_KEY
EVOLUTION_INSTANCE=lotus

# Queue
QUEUE_NAME=whatsapp_dispatch
QUEUE_MAX_ATTEMPTS=5

# Optional admin protection for manual reprocess endpoint (future use)
ADMIN_API_KEY=CHANGE_ME_ADMIN_API_KEY

# Optional: Lotus read-only database access for mapping/diagnostics
# Keep read-only user only.
LOTUS_DB_READONLY_URL=postgres://lotus_readonly:CHANGE_ME@lotus-db-host:5432/lotus
