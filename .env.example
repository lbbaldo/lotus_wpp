# Runtime
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Bot database (microservice own database)
DATABASE_URL=postgres://bot_user:change_me@localhost:5432/whatsapp_bot
REDIS_URL=redis://localhost:6379

# Lotus -> Bot webhook security
LOTUS_WEBHOOK_API_KEY=change_me_lotus_key_with_32_plus_chars
LOTUS_WEBHOOK_HMAC_SECRET=change_me_hmac_secret_with_32_plus_chars
LOTUS_WEBHOOK_MAX_SKEW_SECONDS=300

# Evolution API v2
EVOLUTION_BASE_URL=https://evolution.example.com
EVOLUTION_API_KEY=change_me_evolution_api_key
EVOLUTION_INSTANCE=lotus

# Queue
QUEUE_NAME=whatsapp_dispatch
QUEUE_MAX_ATTEMPTS=5

# Optional admin protection for manual reprocess endpoint (future use)
ADMIN_API_KEY=change_me_admin_key

# Optional: Lotus read-only database access for mapping/diagnostics
LOTUS_DB_READONLY_URL=postgres://lotus_readonly:change_me@localhost:5432/lotus
